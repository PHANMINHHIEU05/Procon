<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>vn.ptit.procon</groupId>
        <artifactId>procon-bot</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>bot-benchmark</artifactId>
    <name>HEXUDON Bot Benchmark</name>

    <dependencies>
        <dependency>
            <groupId>vn.ptit.procon</groupId>
            <artifactId>bot-planner</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Read-only protocol access for the offline live-state corpus replay: the captured payloads are
          rebuilt into a DayState with the production SetupMapper/DayStateMapper and re-encoded with the
          production ActionEncoder. This module contains no HTTP client and submits nothing.
        -->
        <dependency>
            <groupId>vn.ptit.procon</groupId>
            <artifactId>bot-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The corpus loader, replay and scorecard are executable evidence, so they carry tests. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>joint-team-beam-benchmark</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>vn.ptit.procon.benchmark.JointTeamBeamBenchmark</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
